#!/usr/bin/env bash
# Case: ingest-overload (Phase 1) — the real memory path driven to
# saturation: repeated maximum-size legal OTLP gauge exports through the
# ingestion pipeline into the in-memory store at the contract ceilings,
# until the accounted ceiling holds and then `QueueSaturated` persists.
#
# The probe prints one JSON record on stdout (captured verbatim by
# run-all.sh) and exits 0 when it ran and measured; build chatter goes to
# stderr. Phase 1 measures, it does not gate (docs/benchmarks/README.md).
set -euo pipefail
cd "$(dirname "$0")/../../.."

cargo build --release --locked -p runtime-trail-bench-probes --bin probe-ingest-overload 1>&2
exec target/release/probe-ingest-overload
