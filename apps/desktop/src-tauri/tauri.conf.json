{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runtime Trail",
  "version": "0.0.0",
  "identifier": "io.ecoma.runtimetrail.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @runtime-trail/web dev",
    "beforeBuildCommand": "pnpm --filter @runtime-trail/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Runtime Trail",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8599 http://localhost:8599; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
